FVENTAS_ENV=development
FVENTAS_APP_VERSION=1.0.0
FVENTAS_BUILD_SHA=local
FVENTAS_SECRET_KEY=change-me-in-production
FVENTAS_DATA_BACKEND=json
FVENTAS_DATABASE_URL=sqlite:///data/fventas.db
FVENTAS_REQUIRE_MOBILE_TOKEN=1
FVENTAS_SQL_FALLBACK_TO_JSON=1
FVENTAS_LOGIN_MAX_ATTEMPTS=5
FVENTAS_LOGIN_WINDOW_SECONDS=300
FVENTAS_MAX_UPLOAD_MB=16
FVENTAS_BACKUP_DIR=backups
FVENTAS_LOG_LEVEL=INFO
FVENTAS_STORAGE_BACKEND=local
FVENTAS_STORAGE_PUBLIC_BASE_URL=
FVENTAS_S3_BUCKET=
FVENTAS_S3_REGION=us-east-1
FVENTAS_S3_ENDPOINT_URL=
FVENTAS_S3_PREFIX=fventas
FVENTAS_S3_ACL=
