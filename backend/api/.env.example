WULKAN_ENV=development
WULKAN_APP_VERSION=0.9.0
WULKAN_BUILD_SHA=local
WULKAN_SECRET_KEY=change-me-in-production
WULKAN_DATA_BACKEND=json
WULKAN_DATABASE_URL=sqlite:///data/wulkan.db
WULKAN_REQUIRE_MOBILE_TOKEN=0
WULKAN_SQL_FALLBACK_TO_JSON=1
WULKAN_LOGIN_MAX_ATTEMPTS=5
WULKAN_LOGIN_WINDOW_SECONDS=300
WULKAN_MAX_UPLOAD_MB=16
WULKAN_BACKUP_DIR=backups
WULKAN_LOG_LEVEL=INFO
WULKAN_STORAGE_BACKEND=local
WULKAN_STORAGE_PUBLIC_BASE_URL=
WULKAN_S3_BUCKET=
WULKAN_S3_REGION=us-east-1
WULKAN_S3_ENDPOINT_URL=
WULKAN_S3_PREFIX=wulkan
WULKAN_S3_ACL=
