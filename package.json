{
  "name": "wulkan",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma tecnica B2B2C Wulkan para Venezuela.",
  "packageManager": "pnpm@9.12.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend/*"
  ],
  "scripts": {
    "dev:admin": "pnpm --filter @wulkan/admin dev",
    "dev:admin:npm": "npm --workspace @wulkan/admin run dev --",
    "dev:admin:flask": "python backend/api/app.py",
    "emulators:firebase": "firebase emulators:start --only firestore,functions,hosting",
    "seed:firestore": "node infra/scripts/seed-firestore.mjs",
    "verify:firestore": "node infra/scripts/verify-firestore.mjs",
    "smoke:firestore": "firebase emulators:exec --only firestore --project wulkan-dev \"node infra/scripts/seed-firestore.mjs && node infra/scripts/verify-firestore.mjs\"",
    "build:admin": "pnpm --filter @wulkan/admin build",
    "build:admin:npm": "npm --workspace @wulkan/admin run build",
    "mobile:run": "cd apps/mobile && flutter run --dart-define-from-file=dart_defines.example.json",
    "mobile:run:api": "cd apps/mobile && flutter run --dart-define-from-file=dart_defines.example.json --dart-define=WULKAN_MOBILE_DATA_SOURCE=api --dart-define=WULKAN_ADMIN_API_URL=http://10.0.2.2:5000/api/mobile --dart-define=WULKAN_MOBILE_ORDER_API_URL=http://10.0.2.2:5000/api/mobile/orders",
    "mobile:run:firestore": "cd apps/mobile && flutter run --dart-define-from-file=dart_defines.example.json --dart-define=WULKAN_MOBILE_DATA_SOURCE=firestore",
    "mobile:build:apk": "cd apps/mobile && flutter build apk --debug --dart-define-from-file=dart_defines.example.json",
    "mobile:test": "cd apps/mobile && flutter test",
    "lint": "pnpm -r lint",
    "lint:npm": "npm run lint --workspaces --if-present",
    "test": "pnpm -r test",
    "test:npm": "npm run test --workspaces --if-present",
    "typecheck": "pnpm -r typecheck",
    "typecheck:npm": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "firebase-tools": "^15.18.0"
  }
}
