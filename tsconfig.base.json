{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@wulkan/domain": ["packages/domain/src/index.ts"],
      "@wulkan/shared": ["packages/shared/src/index.ts"],
      "@wulkan/ui": ["packages/ui/src/index.ts"],
      "@wulkan/config": ["packages/config/src/index.ts"]
    }
  }
}
