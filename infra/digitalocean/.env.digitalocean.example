FVENTAS_ENV=production
FVENTAS_APP_VERSION=1.0.0
FVENTAS_BUILD_SHA=digitalocean-main
FVENTAS_SECRET_KEY=replace-with-a-long-random-secret
FVENTAS_DATA_BACKEND=sql
FVENTAS_SQL_FALLBACK_TO_JSON=0
FVENTAS_REQUIRE_MOBILE_TOKEN=1
FVENTAS_REJECT_LEGACY_MOBILE_TOKENS=1
FVENTAS_REQUIRE_MOBILE_DEVICE_HEADER=1
FVENTAS_ALLOW_LEGACY_MOBILE_API=0
FVENTAS_READYZ_PUBLIC_DETAILS=0
FVENTAS_CSP_REPORT_ONLY=0
FVENTAS_TRUST_PROXY_HEADERS=1
FVENTAS_LOGIN_MAX_ATTEMPTS=5
FVENTAS_LOGIN_WINDOW_SECONDS=300
FVENTAS_LANDING_ACCESS_PREFERENCE_WINDOW_SECONDS=60
FVENTAS_LANDING_ACCESS_PREFERENCE_MAX_EVENTS=12
FVENTAS_SIGNUP_WINDOW_SECONDS=300
FVENTAS_SIGNUP_MAX_EVENTS=5
FVENTAS_ACCOUNT_DELETION_WINDOW_SECONDS=300
FVENTAS_ACCOUNT_DELETION_MAX_EVENTS=5
FVENTAS_MOBILE_PASSWORD_RECOVERY_WINDOW_SECONDS=300
FVENTAS_MOBILE_PASSWORD_RECOVERY_MAX_EVENTS=5
FVENTAS_MAX_UPLOAD_MB=16
FVENTAS_WEB_WORKERS=1
FVENTAS_WEB_THREADS=4
FVENTAS_GUNICORN_TIMEOUT=60
FVENTAS_GUNICORN_MAX_REQUESTS=600
FVENTAS_GUNICORN_MAX_REQUESTS_JITTER=60
FVENTAS_DB_POOL_SIZE=2
FVENTAS_DB_MAX_OVERFLOW=2
FVENTAS_DB_POOL_RECYCLE_SECONDS=1800
FVENTAS_RUN_MIGRATIONS=1
FVENTAS_HARDEN_DEFAULT_ACCOUNTS=1

# DigitalOcean Managed PostgreSQL.
# App Platform can inject this as ${FVENTAS-db.DATABASE_URL}.
FVENTAS_DATABASE_URL=postgresql+psycopg://doadmin:password@host:25060/defaultdb?sslmode=require

# DigitalOcean Spaces, S3-compatible storage.
FVENTAS_STORAGE_BACKEND=s3
FVENTAS_STORAGE_PUBLIC_BASE_URL=https://fventas-assets.atl1.cdn.digitaloceanspaces.com
FVENTAS_S3_BUCKET=fventas-assets
FVENTAS_S3_REGION=atl1
FVENTAS_S3_ENDPOINT_URL=https://atl1.digitaloceanspaces.com
FVENTAS_S3_PREFIX=production
FVENTAS_S3_ACL=public-read
AWS_ACCESS_KEY_ID=replace-with-digitalocean-spaces-key
AWS_SECRET_ACCESS_KEY=replace-with-digitalocean-spaces-secret

# Bootstrap inicial seguro. Ejecutar scripts/bootstrap_production.py con valores reales.
FVENTAS_BOOTSTRAP_ON_START=0
FVENTAS_BOOTSTRAP_RESET_PASSWORDS=0
FVENTAS_BOOTSTRAP_COMPANY_ID=company-fventas-chile
FVENTAS_BOOTSTRAP_COMPANY_NAME=FVENTAS
FVENTAS_BOOTSTRAP_COMPANY_LEGAL_NAME=
FVENTAS_BOOTSTRAP_COMPANY_TAX_ID=
FVENTAS_BOOTSTRAP_COUNTRY=CL
FVENTAS_BOOTSTRAP_OWNER_NAME=
FVENTAS_BOOTSTRAP_OWNER_EMAIL=
FVENTAS_BOOTSTRAP_ADMIN_NAME=
FVENTAS_BOOTSTRAP_ADMIN_EMAIL=
FVENTAS_BOOTSTRAP_ADMIN_PASSWORD=
FVENTAS_BOOTSTRAP_SELLER_NAME=
FVENTAS_BOOTSTRAP_SELLER_EMAIL=
FVENTAS_BOOTSTRAP_SELLER_PASSWORD=
FVENTAS_BOOTSTRAP_CLIENT_BUSINESS_NAME=
FVENTAS_BOOTSTRAP_CLIENT_EMAIL=
FVENTAS_BOOTSTRAP_CLIENT_PASSWORD=
