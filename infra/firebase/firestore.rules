rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() ? request.auth.token.role : null;
    }

    function isWulkanStaff() {
      return role() in ['super_admin', 'wulkan_admin', 'wulkan_operator'];
    }

    function isAdmin() {
      return role() in ['super_admin', 'wulkan_admin'];
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if isWulkanStaff();
      allow delete: if isAdmin();
    }

    match /product_variants/{variantId} {
      allow read: if true;
      allow create, update: if isWulkanStaff();
      allow delete: if isAdmin();
    }

    match /product_prices/{priceId} {
      allow read: if signedIn();
      allow create, update: if isWulkanStaff();
      allow delete: if isAdmin();
    }

    match /product_stock/{stockId} {
      allow read: if signedIn();
      allow create, update: if isWulkanStaff();
      allow delete: if isAdmin();
    }

    match /product_compatibilities/{compatibilityId} {
      allow read: if true;
      allow create, update: if isWulkanStaff();
      allow delete: if isAdmin();
    }

    match /business_verticals/{verticalId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if signedIn() && (isWulkanStaff() || request.auth.uid == userId);
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /companies/{companyId} {
      allow read: if signedIn();
      allow create, update: if isWulkanStaff();
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if signedIn() && (isWulkanStaff() || resource.data.customerId == request.auth.uid);
      allow create: if signedIn();
      allow update: if isWulkanStaff();
      allow delete: if false;
    }

    match /purchase_orders/{purchaseOrderId} {
      allow read, create: if signedIn();
      allow update: if isWulkanStaff();
      allow delete: if false;
    }

    match /replenishment_requests/{requestId} {
      allow read, create: if signedIn();
      allow update: if isWulkanStaff();
      allow delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /service_cases/{caseId} {
      allow read, create: if signedIn();
      allow update: if signedIn();
      allow delete: if false;
    }

    match /service_case_events/{eventId} {
      allow read, create: if signedIn();
      allow update, delete: if false;
    }

    match /quotes/{quoteId} {
      allow read, create: if signedIn();
      allow update: if isWulkanStaff();
      allow delete: if false;
    }

    match /locations/{locationId} {
      allow read: if true;
      allow create, update: if isWulkanStaff();
      allow delete: if isAdmin();
    }

    match /technical_projects/{projectId} {
      allow read, create: if signedIn();
      allow update: if isWulkanStaff();
      allow delete: if false;
    }

    match /company_performance_reports/{reportId} {
      allow read: if isWulkanStaff();
      allow write: if false;
    }

    match /marketplace_applications/{applicationId} {
      allow read, create: if signedIn();
      allow update: if isWulkanStaff();
      allow delete: if false;
    }

    match /mobile_announcements/{announcementId} {
      allow read: if true;
      allow create, update: if isWulkanStaff();
      allow delete: if isAdmin();
    }

    match /product_approvals/{approvalId} {
      allow read: if signedIn();
      allow create, update: if isWulkanStaff();
      allow delete: if false;
    }

    match /seller_quality_scores/{scoreId} {
      allow read: if isWulkanStaff();
      allow write: if false;
    }

    match /platform_charges/{chargeId} {
      allow read: if isWulkanStaff();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /app_settings/{settingId} {
      allow read: if isWulkanStaff();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
